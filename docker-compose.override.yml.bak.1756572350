services:
  backend:
    command: ["python","-m","uvicorn","app.main:app","--host","0.0.0.0","--port","8000","--workers","1"]
    restart: unless-stopped
    environment:
      API_KEY: ""
    healthcheck:
      test: ["CMD","curl","-fsS","http://127.0.0.1:8000/healthz"]
      interval: 10s
      timeout: 3s
      retries: 10
      start_period: 20s
