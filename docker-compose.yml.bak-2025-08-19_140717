  # docker compose v2 (без поля version)
# Сети: внешняя для прокси и внутренняя для приложения
networks:
  nginx-proxy:
    external: true
  app-net: {}

volumes:
  pgdata: {}

services:
  db:
    image: postgres:16-alpine
    container_name: myapp-db
    restart: always
    env_file:
      - .env
    environment:
      POSTGRES_DB: "${POSTGRES_DB}"
      POSTGRES_USER: "${POSTGRES_USER}"
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}"
    volumes:
      - pgdata:/var/lib/postgresql/data
    networks:
      - app-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$${POSTGRES_USER}\" -d \"$${POSTGRES_DB}\" -h 127.0.0.1"]
      interval:60s
      timeout: 10s
      retries: 5

  backend:
    build:
      context: ./backend            # укажите свой путь, если иной
      dockerfile: Dockerfile
    container_name: myapp-backend
    restart: always
    expose:
      - "8000"                      # внутренний порт приложения
    env_file:
      - .env
    # Явный проброс критичных переменных + настройки для nginx-proxy/LE
    environment:
      # критичные для приложения
      DATABASE_URL: "${DATABASE_URL}"
      SECRET_KEY: "${SECRET_KEY}"
      APP_ENV: "${APP_ENV}"
      ALLOWED_ORIGINS: "${ALLOWED_ORIGINS}"
      # для nginx-proxy / Let's Encrypt
      VIRTUAL_HOST: "${APP_DOMAIN}"
      VIRTUAL_PORT: "${VIRTUAL_PORT}"

^G Help        ^O Write Out   ^W Where Is    ^K Cut         ^T Execute     ^C Location    M-U Undo       M-A Set Mark
^X Exit        ^R Read F
